# Copy to .env and adjust. Nothing here is a secret — the local stack is
# deliberately credential-free so a contributor can start without asking
# anyone for anything.

# ---- database ----
DATABASE_URL=postgres://landfall:landfall@localhost:5432/landfall

# ---- ledger ----
# Local Quickstart by default. Point at mainnet to scan real anchors:
#   HORIZON_URL=https://horizon.stellar.org
HORIZON_URL=http://localhost:8000
SOROBAN_RPC_URL=http://localhost:8001

# ---- indexer ----
SCAN_INTERVAL_SECONDS=900
DUST_THRESHOLD=0.01
MAX_RECORDS=10000

# ---- api ----
PORT=8787
CORS_ORIGIN=*

# ---- oracle (only needed to publish on-chain) ----
# ORACLE_CONTRACT_ID=
# ORACLE_ADMIN_SECRET=
