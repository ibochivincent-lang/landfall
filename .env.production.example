# Landfall — production environment.
#
#   cp .env.production.example .env
#
# Unlike .env.example, this file describes real credentials. Do not commit the
# filled-in copy: .env is in .gitignore and must stay there.

# ---------------------------------------------------------------- database
#
# Supabase gives you two connection strings and they are not interchangeable.
#
#   Direct        …@db.<ref>.supabase.co:5432/postgres
#   Transaction   …@aws-0-<region>.pooler.supabase.com:6543/postgres
#                 (username becomes postgres.<ref>)
#
# Use the DIRECT string (5432) for migrations. The transaction pooler is
# PgBouncer in transaction mode: it does not hold a session across statements,
# so prepared statements, advisory locks and multi-statement transactions can
# fail in ways that leave a migration half-applied.
#
# Use the POOLED string (6543) for the API and indexer. Supabase's direct
# connection limit is low and IPv6-only on some plans; the pooler is neither.
#
# Connect as the OWNER role. Migration 002 enables row-level security on every
# table, and a non-owner role gets zero rows rather than an error. The API
# prints a warning at startup if it detects this.
#
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# For `npm run db:migrate` only. Direct connection, port 5432.
MIGRATE_DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require

# PgBouncer counts every client connection against the project's pool. Keep
# these small and deliberate; the defaults assume a Supabase free tier.
PG_POOL_MAX=8
INDEXER_POOL_MAX=2

# ---------------------------------------------------------------- ledger
HORIZON_URL=https://horizon.stellar.org
SOROBAN_RPC_URL=https://mainnet.sorobanrpc.com

# ---------------------------------------------------------------- indexer
# Hourly. Anchor liveness is measured in hours and days; scanning every
# fifteen minutes would add Horizon load to sharpen a figure nobody reads at
# that resolution.
SCAN_INTERVAL_SECONDS=3600
DUST_THRESHOLD=0.01
MAX_RECORDS=10000

# ---------------------------------------------------------------- api
API_PORT=8787
# The exact origin of your site. Not '*'. A read-only API leaks nothing, but a
# wildcard invites other people's pages to present our numbers as their own,
# without the caveats that travel in the payload.
CORS_ORIGIN=https://landfall-ib.vercel.app

# ---------------------------------------------------------------- oracle
# Written by scripts/deploy-contract.sh. The admin secret is NOT stored here —
# it lives in the stellar CLI keystore, or in the host's secret manager.
# ORACLE_CONTRACT_ID=
# ORACLE_ADMIN_SECRET=
