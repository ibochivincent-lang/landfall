{
  "name": "landfall",
  "version": "0.2.0",
  "private": true,
  "description": "Ledger-derived settlement record for Stellar anchors.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/indexer",
    "packages/api"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "discover": "npm run discover -w @landfall/indexer",
    "scan": "npm run scan -w @landfall/indexer",
    "api": "npm run dev -w @landfall/api",
    "test": "npm run test -w @landfall/indexer",
    "typecheck": "npm run typecheck -w @landfall/indexer && npm run typecheck -w @landfall/api",
    "db:migrate": "bash scripts/migrate.sh",
    "mcp": "node scripts/mcp/server.mjs",
    "stack:up": "docker compose up -d",
    "stack:down": "docker compose down",
    "stack:logs": "docker compose logs -f",
    "prod:up": "docker compose -f docker-compose.prod.yml up -d --build",
    "prod:down": "docker compose -f docker-compose.prod.yml down",
    "prod:logs": "docker compose -f docker-compose.prod.yml logs -f",
    "contracts:deploy": "bash scripts/deploy-contract.sh",
    "contracts:deploy:testnet": "bash scripts/deploy-contract.sh testnet",
    "contracts:build": "cd packages/contracts && cargo build --target wasm32v1-none --release",
    "contracts:test": "cd packages/contracts && cargo test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "graphql": "^17.0.2",
    "openai": "^4.55.0",
    "pg": "^8.13.1",
    "zod": "^4.4.3"
  },
  "overrides": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
