node_modules/
dist/
.cache/
out/
*.log
.env
.env.local
.env.production
.DS_Store

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/

# monorepo
packages/contracts/target/
packages/*/node_modules/

# written by scripts/deploy-contract.sh. Deliberately not committed: the file
# is what stops a second deploy silently orphaning the first contract, and a
# committed copy would make every fresh clone refuse to deploy.
.contract-id

# Local agent/session settings — not part of the project
.claude/
.agents/

# Build output for the published SDK — regenerated by `npm run build -w @landfall/sdk`
packages/sdk/dist/
packages/sdk/*.tgz

# Snapshots from the on-demand MAX_BATCH probe (src/bench_probe.rs, #[ignore]).
# It writes one per invocation across a sweep; they are diagnostic output, not
# a fixture anything asserts against.
packages/contracts/landfall-oracle/test_snapshots/bench_probe/
node_modules
